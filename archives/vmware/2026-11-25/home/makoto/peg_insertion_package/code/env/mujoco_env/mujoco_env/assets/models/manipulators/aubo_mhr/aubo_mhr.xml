<mujoco model="aubo_mhr">
  <compiler angle="radian" eulerseq="zyx" autolimits="true" />

  <default>
    <joint limited="true" damping="0.01" armature="0.01" frictionloss="0.01" />
    <geom condim="4" contype="1" conaffinity="15" friction="0.9 0.2 0.2" solref="0.001 2" />
    <motor ctrllimited="true" />
    <equality solref="0.001 2" />
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0" />
    </default>
  </default>

  <asset>
    <mesh name="link0" content_type="model/stl" file="meshes/link0.STL" />
    <mesh name="link1" content_type="model/stl" file="meshes/link1.STL" />
    <mesh name="link2" content_type="model/stl" file="meshes/link2.STL" />
    <mesh name="link3" content_type="model/stl" file="meshes/link3.STL" />
    <mesh name="link4" content_type="model/stl" file="meshes/link4.STL" />
    <mesh name="link5" content_type="model/stl" file="meshes/link5.STL" />
    <mesh name="link6" content_type="model/stl" file="meshes/link6.STL" />
    <mesh name="link7" content_type="model/stl" file="meshes/link7.STL" />
    <mesh name="base_link" content_type="model/stl" file="meshes/base_link.STL" />
    <mesh name="body_link" content_type="model/stl" file="meshes/body_link.STL" scale="1.07 1.07 1.07" />
    <mesh name="neck_rotation" content_type="model/stl" file="meshes/neck_rotation.STL" />
    <mesh name="neck_pitch" content_type="model/stl" file="meshes/neck_pitch.STL" />
    <mesh name="base_leftArm" content_type="model/stl" file="meshes/base_leftArm.STL" />
    <mesh name="base_rightArm" content_type="model/stl" file="meshes/base_rightArm.STL" />

    <mesh name="sus_link" content_type="model/stl" file="../../mobile_bases/aubo_mhr/meshes/sus_link.stl" />
    <mesh name="robot_wheel" content_type="model/stl" file="../../mobile_bases/aubo_mhr/meshes/robot_wheel.stl" />

    <mesh name="camera_chest" content_type="model/stl" file="../../sensors/aubo_mhr/meshes/camera_chest.STL" />
    <mesh name="camera_head" content_type="model/stl" file="../../sensors/aubo_mhr/meshes/camera_head.STL" />

    <mesh name="gripper_base_visual" file="../../grippers/aubo_mhr/meshes/visual/gripper_base.stl" />
    <mesh name="gripper_link1_visual" file="../../grippers/aubo_mhr/meshes/visual/gripper_link1.stl" />
    <mesh name="gripper_link2_visual" file="../../grippers/aubo_mhr/meshes/visual/gripper_link2.stl" />
    <mesh name="gripper_link_finger_visual" file="../../grippers/aubo_mhr/meshes/visual/gripper_link_finger.stl" />

    <mesh name="gripper_base_collision" file="../../grippers/aubo_mhr/meshes/collision/gripper_base.stl" />
    <mesh name="gripper_link1_collision" file="../../grippers/aubo_mhr/meshes/collision/gripper_link1.stl" />
    <mesh name="gripper_link2_collision" file="../../grippers/aubo_mhr/meshes/collision/gripper_link2.stl" />
    <mesh name="gripper_link_finger_collision" file="../../grippers/aubo_mhr/meshes/collision/gripper_link_finger.stl" />

    <material name="visualgeom" rgba="0.5 0.9 0.2 1" />
  </asset>

  <worldbody>
    <body name="root">
      <site name="imu" size="0.01" pos="0 0 0" />
      <include file="../../mobile_bases/aubo_mhr/aubo_mhr_base_body.xml" />
      <include file="aubo_mhr_manipulator_body.xml" />
    </body>
  </worldbody>

  <actuator>
    <motor name="front_right_steering_joint" joint="front_right_steering_joint" ctrllimited="true" ctrlrange="-5 5" gear="1" />
    <motor name="front_left_steering_joint" joint="front_left_steering_joint" ctrllimited="true" ctrlrange="-5 5" gear="1" />
    <motor name="rear_right_steering_joint" joint="rear_right_steering_joint" ctrllimited="true" ctrlrange="-5 5" gear="1" />
    <motor name="rear_left_steering_joint" joint="rear_left_steering_joint" ctrllimited="true" ctrlrange="-5 5" gear="1" />
    <motor name="robot_joint" joint="robot_joint" ctrllimited="true" ctrlrange="-100 100" gear="1" />
    <motor name="l_shoulder_roll" joint="l_shoulder_roll" ctrllimited="true" ctrlrange="-40 40" gear="1" />
    <motor name="l_shoulder_pitch" joint="l_shoulder_pitch" ctrllimited="true" ctrlrange="-40 40" gear="1" />
    <motor name="l_shoulder_yaw" joint="l_shoulder_yaw" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="l_elbow" joint="l_elbow" ctrllimited="true" ctrlrange="-22 22" gear="1" />
    <motor name="l_wrist_roll" joint="l_wrist_roll" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="l_wrist_pitch" joint="l_wrist_pitch" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="l_wrist_yaw" joint="l_wrist_yaw" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="gripper_r_joint1_left" joint="gripper_r_joint1_left" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_r_joint2_left" joint="gripper_r_joint2_left" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_r_joint_finger_left" joint="gripper_r_joint_finger_left" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_l_joint1_left" joint="gripper_l_joint1_left" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_l_joint2_left" joint="gripper_l_joint2_left" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_l_joint_finger_left" joint="gripper_l_joint_finger_left" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="r_shoulder_roll" joint="r_shoulder_roll" ctrllimited="true" ctrlrange="-40 40" gear="1" />
    <motor name="r_shoulder_pitch" joint="r_shoulder_pitch" ctrllimited="true" ctrlrange="-40 40" gear="1" />
    <motor name="r_shoulder_yaw" joint="r_shoulder_yaw" ctrllimited="true" ctrlrange="-22 22" gear="1" />
    <motor name="r_elbow" joint="r_elbow" ctrllimited="true" ctrlrange="-22 22" gear="1" />
    <motor name="r_wrist_roll" joint="r_wrist_roll" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="r_wrist_pitch" joint="r_wrist_pitch" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="r_wrist_yaw" joint="r_wrist_yaw" ctrllimited="true" ctrlrange="-8 8" gear="1" />
    <motor name="gripper_r_joint1_right" joint="gripper_r_joint1_right" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_r_joint2_right" joint="gripper_r_joint2_right" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_r_joint_finger_right" joint="gripper_r_joint_finger_right" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_l_joint1_right" joint="gripper_l_joint1_right" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_l_joint2_right" joint="gripper_l_joint2_right" ctrllimited="true" ctrlrange="-10 10" gear="1" />
    <motor name="gripper_l_joint_finger_right" joint="gripper_l_joint_finger_right" ctrllimited="true" ctrlrange="-10 10" gear="1" />
  </actuator>

  <sensor>
    <actuatorpos name="front_right_steering_joint_p" actuator="front_right_steering_joint" />
    <actuatorvel name="front_right_steering_joint_v" actuator="front_right_steering_joint" />
    <actuatorfrc name="front_right_steering_joint_f" actuator="front_right_steering_joint" noise="0.001" />
    <actuatorpos name="front_left_steering_joint_p" actuator="front_left_steering_joint" />
    <actuatorvel name="front_left_steering_joint_v" actuator="front_left_steering_joint" />
    <actuatorfrc name="front_left_steering_joint_f" actuator="front_left_steering_joint" noise="0.001" />
    <actuatorpos name="rear_right_steering_joint_p" actuator="rear_right_steering_joint" />
    <actuatorvel name="rear_right_steering_joint_v" actuator="rear_right_steering_joint" />
    <actuatorfrc name="rear_right_steering_joint_f" actuator="rear_right_steering_joint" noise="0.001" />
    <actuatorpos name="rear_left_steering_joint_p" actuator="rear_left_steering_joint" />
    <actuatorvel name="rear_left_steering_joint_v" actuator="rear_left_steering_joint" />
    <actuatorfrc name="rear_left_steering_joint_f" actuator="rear_left_steering_joint" noise="0.001" />
    <actuatorpos name="robot_joint_p" actuator="robot_joint" />
    <actuatorvel name="robot_joint_v" actuator="robot_joint" />
    <actuatorfrc name="robot_joint_f" actuator="robot_joint" noise="0.001" />
    <actuatorpos name="l_shoulder_roll_p" actuator="l_shoulder_roll" />
    <actuatorvel name="l_shoulder_roll_v" actuator="l_shoulder_roll" />
    <actuatorfrc name="l_shoulder_roll_f" actuator="l_shoulder_roll" noise="0.001" />
    <actuatorpos name="l_shoulder_pitch_p" actuator="l_shoulder_pitch" />
    <actuatorvel name="l_shoulder_pitch_v" actuator="l_shoulder_pitch" />
    <actuatorfrc name="l_shoulder_pitch_f" actuator="l_shoulder_pitch" noise="0.001" />
    <actuatorpos name="l_shoulder_yaw_p" actuator="l_shoulder_yaw" />
    <actuatorvel name="l_shoulder_yaw_v" actuator="l_shoulder_yaw" />
    <actuatorfrc name="l_shoulder_yaw_f" actuator="l_shoulder_yaw" noise="0.001" />
    <actuatorpos name="l_elbow_p" actuator="l_elbow" />
    <actuatorvel name="l_elbow_v" actuator="l_elbow" />
    <actuatorfrc name="l_elbow_f" actuator="l_elbow" noise="0.001" />
    <actuatorpos name="l_wrist_roll_p" actuator="l_wrist_roll" />
    <actuatorvel name="l_wrist_roll_v" actuator="l_wrist_roll" />
    <actuatorfrc name="l_wrist_roll_f" actuator="l_wrist_roll" noise="0.001" />
    <actuatorpos name="l_wrist_pitch_p" actuator="l_wrist_pitch" />
    <actuatorvel name="l_wrist_pitch_v" actuator="l_wrist_pitch" />
    <actuatorfrc name="l_wrist_pitch_f" actuator="l_wrist_pitch" noise="0.001" />
    <actuatorpos name="l_wrist_yaw_p" actuator="l_wrist_yaw" />
    <actuatorvel name="l_wrist_yaw_v" actuator="l_wrist_yaw" />
    <actuatorfrc name="l_wrist_yaw_f" actuator="l_wrist_yaw" noise="0.001" />
    <actuatorpos name="r_shoulder_roll_p" actuator="r_shoulder_roll" />
    <actuatorvel name="r_shoulder_roll_v" actuator="r_shoulder_roll" />
    <actuatorfrc name="r_shoulder_roll_f" actuator="r_shoulder_roll" noise="0.001" />
    <actuatorpos name="r_shoulder_pitch_p" actuator="r_shoulder_pitch" />
    <actuatorvel name="r_shoulder_pitch_v" actuator="r_shoulder_pitch" />
    <actuatorfrc name="r_shoulder_pitch_f" actuator="r_shoulder_pitch" noise="0.001" />
    <actuatorpos name="r_shoulder_yaw_p" actuator="r_shoulder_yaw" />
    <actuatorvel name="r_shoulder_yaw_v" actuator="r_shoulder_yaw" />
    <actuatorfrc name="r_shoulder_yaw_f" actuator="r_shoulder_yaw" noise="0.001" />
    <actuatorpos name="r_elbow_p" actuator="r_elbow" />
    <actuatorvel name="r_elbow_v" actuator="r_elbow" />
    <actuatorfrc name="r_elbow_f" actuator="r_elbow" noise="0.001" />
    <actuatorpos name="r_wrist_roll_p" actuator="r_wrist_roll" />
    <actuatorvel name="r_wrist_roll_v" actuator="r_wrist_roll" />
    <actuatorfrc name="r_wrist_roll_f" actuator="r_wrist_roll" noise="0.001" />
    <actuatorpos name="r_wrist_pitch_p" actuator="r_wrist_pitch" />
    <actuatorvel name="r_wrist_pitch_v" actuator="r_wrist_pitch" />
    <actuatorfrc name="r_wrist_pitch_f" actuator="r_wrist_pitch" noise="0.001" />
    <actuatorpos name="r_wrist_yaw_p" actuator="r_wrist_yaw" />
    <actuatorvel name="r_wrist_yaw_v" actuator="r_wrist_yaw" />
    <actuatorfrc name="r_wrist_yaw_f" actuator="r_wrist_yaw" noise="0.001" />
