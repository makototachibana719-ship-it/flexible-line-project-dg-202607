<mujoco model="realsense_gripper">
  <asset>
    <!-- 使用realsense相机的mesh文件 -->
    <mesh name="cambase" file="../realsense/meshes/cambase.STL" />
    <mesh name="cam" file="../realsense/meshes/cam.STL" />
  </asset>
  
  <worldbody>
    <body name="end_effector" quat="0 -1 0 0">
      <!-- 相机基座 -->
      <geom type="mesh" rgba="0.8 0.8 0.8 1" mesh="cambase" />
      
      <!-- 相机主体 -->
      <body name="cam_body" pos="0.065054 0.00068038 -0.013835" quat="-2.59734e-06 0.707105 0.707108 -2.59735e-06">
        <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="0.2 0.2 0.2 1" mesh="cam" />
        
        <!-- 腕上相机 - 用于采集图像 -->
        <camera name="wrist_cam" mode="fixed" pos="0.0175 0.00 0.008" quat="0 0 1 0" fovy="60"/>
      </body>
      
      <!-- 末端执行器框架 -->
      <body name="end" pos="0 0.15 0" quat="0.707105 -0.707108 0 0">
        <site name="gripper_frame" size="0.01" rgba="1 0 0 0.5"/>
        <site name="gripper_site" size="0.005" pos="0 0 0" rgba="0 1 0 0.5"/>
      </body>
    </body>
  </worldbody>
</mujoco>

