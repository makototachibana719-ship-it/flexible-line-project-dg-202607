        <mesh name="aubo_link6" file="../../manipulators/Aubo_i5/meshes/collision/link6.STL"/>
        
        <!-- RealSense 摄像头 meshes -->
        <mesh name="cambase" file="../../grippers/realsense_usb/meshes/cambase.STL"/>
        <mesh name="cam" file="../../grippers/realsense_usb/meshes/cam.STL"/>
        
        <!-- Robotiq 2F-85 夹爪 meshes -->
        <mesh name="robotiq_base" file="../../grippers/robotiq_gripper/meshes/robotiq-2f-base.stl" scale="0.001 0.001 0.001"/>
        <mesh name="robotiq_driver" file="../../grippers/robotiq_gripper/meshes/robotiq-2f-driver.stl" scale="0.001 0.001 0.001"/>
        <mesh name="robotiq_coupler" file="../../grippers/robotiq_gripper/meshes/robotiq-2f-coupler.stl" scale="0.001 0.001 0.001"/>
        <mesh name="robotiq_follower" file="../../grippers/robotiq_gripper/meshes/robotiq-2f-follower.stl" scale="0.001 0.001 0.001"/>
        <mesh name="robotiq_pad" file="../../grippers/robotiq_gripper/meshes/robotiq-2f-pad.stl" scale="0.001 0.001 0.001"/>
        <mesh name="robotiq_spring_link" file="../../grippers/robotiq_gripper/meshes/robotiq-2f-spring_link.stl" scale="0.001 0.001 0.001"/>
    </asset>

    <!-- 世界体 -->
    <worldbody>
        <!-- 地板 -->
        <geom condim="3" material="MatPlane" name="floor" pos="0 0 0" size="10 10 0.125" type="plane"/>
        
        <!-- 光源 -->
        <!--light diffuse="0.8 0.8 0.8" dir="0 -0.15 -1" directional="false" pos="1 1 3.0" specular="0.3 0.3 0.3" castshadow="false"/!>
        <light diffuse="0.8 0.8 0.8" dir="0 -0.15 -1" directional="false" pos="-2 -2 3.0" specular="0.3 0.3 0.3" castshadow="false"/>
