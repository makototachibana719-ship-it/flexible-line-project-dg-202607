<mujoco model="freight_aubo_i5">
    <compiler angle="radian"/>
    <size njmax="1000" nconmax="200" nstack="600000"/>
    
    <!-- 默认样式定义 -->
    <default>
        <!-- Freight 货运车样式 -->
        <default class="freight">
            <joint armature="0" damping="0" limited="false"/>
            <default class="freight_visual">
                <geom conaffinity="0" contype="0" group="2" density="0"/>
            </default>
            <default class="freight_collision">
                <geom conaffinity="1" contype="1" condim="3" group="3" friction="1 0.5 0.5"/>
            </default>
        </default>
        
        <!-- Aubo i5 机械臂样式 -->
        <default class="aubo">
            <default class="visual">
                <geom group="2" type="mesh" contype="0" conaffinity="0" density="0"/>
            </default>
            <default class="collision">
                <geom group="3" type="mesh" rgba="1 1 1 1" density="2700"/>
            </default>
        </default>
        
        <!-- Robotiq 2F-85 夹爪样式 -->
        <default class="robotiq2f85">
            <joint damping="0.1" pos="0 0 0" axis="1 0 0" limited="true"/>
            <geom rgba="0.1 0.1 0.1 1" type="mesh" contype="0" conaffinity="0" group="1"/>
            <default class="robotiq_col">
                <geom rgba="0.3 0.4 0.5 1" type="mesh" contype="1" conaffinity="0" group="3"/>
            </default>
            <default class="robotiq_pad_col">
                <geom rgba="0.3 0.4 0.5 1" type="mesh" contype="1" conaffinity="1" group="3" 
                      condim="4" friction="1 1 1" solref="0.001 1" solimp="1 0.99 0.001"/>
            </default>
        </default>
    </default>

    <!-- 物理选项 -->
    <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" impratio="10">
        <flag contact="enable" energy="enable" gravity="enable"/>
    </option>

    <!-- 视觉设置 -->
    <visual>
        <headlight diffuse="0.8 0.8 0.8" ambient="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
        <rgba haze="0.15 0.25 0.35 1"/>
        <global azimuth="120" elevation="-20"/>
    </visual>

    <!-- 资源定义 -->
    <asset>
        <!-- 地面纹理 -->
        <texture builtin="checker" height="100" name="texplane" rgb1="0.6 0.6 0.6" 
                 rgb2="0.8 0.8 0.8" type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" 
                  texrepeat="60 60" texture="texplane"/>
        
        <!-- Freight 货运车 meshes -->
        <mesh name="freight_base_link" file="meshes/base_link.STL" scale="1.2 1.2 1.2"/>
        <mesh name="freight_base_link_collision" file="meshes/base_link_collision.STL" scale="1.2 1.2 1.2"/>
        <mesh name="freight_estop_link" file="meshes/estop_link.STL" scale="1.2 1.2 1.2"/>
        <mesh name="freight_estop_link_collision" file="meshes/estop_link_collision.STL" scale="1.2 1.2 1.2"/>
        <mesh name="freight_laser_link" file="meshes/laser_link.STL" scale="1.2 1.2 1.2"/>
        <mesh name="freight_laser_link_collision" file="meshes/laser_link_collision.STL" scale="1.2 1.2 1.2"/>
        
        <!-- Aubo i5 材质 -->
        <material name="Opaque(63,63,63)" specular="0.5" shininess="0.5" rgba="0.250980 0.250980 0.250980 1.0"/>
        <material name="Opaque(232,133,0)" specular="0.5" shininess="0.5" rgba="0.909804 0.521569 0.000000 1.0"/>
        
        <!-- Aubo i5 视觉 meshes -->
        <mesh name="aubo_link0_0" file="../../manipulators/Aubo_i5/meshes/visual/link0/link0_0.obj"/>
        <mesh name="aubo_link1_0" file="../../manipulators/Aubo_i5/meshes/visual/link1/link1_0.obj"/>
        <mesh name="aubo_link1_1" file="../../manipulators/Aubo_i5/meshes/visual/link1/link1_1.obj"/>
