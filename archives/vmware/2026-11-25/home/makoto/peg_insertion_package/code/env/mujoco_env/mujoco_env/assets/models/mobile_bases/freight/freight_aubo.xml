        <mesh name="aubo_link3_1" file="../../manipulators/Aubo_i5/meshes/visual/link3/link3_1.obj"/>
        <mesh name="aubo_link4_0" file="../../manipulators/Aubo_i5/meshes/visual/link4/link4_0.obj"/>
        <mesh name="aubo_link4_1" file="../../manipulators/Aubo_i5/meshes/visual/link4/link4_1.obj"/>
