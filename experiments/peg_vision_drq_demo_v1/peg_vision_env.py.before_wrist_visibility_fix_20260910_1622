import numpy as np


PROJECT_ROOT = Path(__file__).resolve().parents[2]
PEG_EXAMPLE = (
    PROJECT_ROOT
    / "external/packages/peg_insertion/peg_insertion/code/example/async_rlpd_peg_sim"
)
PEG_ENV_PARENT = PROJECT_ROOT / "external/packages/peg_insertion/peg_insertion/code/env"
