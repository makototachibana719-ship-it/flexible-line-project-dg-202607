"""One-shot post-exclusion axial diagnostic; never produces training data."""
import json
import os
import subprocess
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from scripts.run_peg_axial_bounded_diagnostic import durable_save, persist_initial_evidence_and_guard
from training.peg_insertion.axial_telemetry import AxialTelemetry, V2
from training.peg_insertion.v2_recorder import PKG, bindings, sha, snapshot, validate_snapshot

OUT = ROOT / "results/diagnostics/peg/f3_axial_bounded_retry_20260905"
OLD = ROOT / "results/demos/peg_v2_pilot/standard_20260905_001"
SOURCE = PKG / "code/env/mujoco_env/mujoco_env/assets/models/manipulators/Aubo_i5/Aubo_i5.xml"
GENERATED = ROOT / "runtime/peg_insertion/generated/aubo_i5_assemble_hole.xml"
TARGET_PAIR = frozenset(("base_link", "shoulder_Link"))
MAX_DIAGNOSTIC_STEPS = 126  # frozen reference ends here; <=160 authorization


def exclusions(path):
    return [frozenset((node.get("body1"), node.get("body2"))) for node in ET.parse(path).findall(".//contact/exclude")]


def enrich_contacts(raw, model):
    result = []
    for contact in raw:
        item = dict(contact)
        for side in (1, 2):
            geom_id = int(item[f"geom{side}_id"])
            body_id = int(model.geom_bodyid[geom_id])
            data_id = int(model.geom_dataid[geom_id])
            item[f"geom{side}_body_id"] = body_id
            item[f"geom{side}_body_name"] = model.body(body_id).name
            item[f"geom{side}_mesh_name"] = model.mesh(data_id).name if int(model.geom_type[geom_id]) == 7 and data_id >= 0 else None
        result.append(item)
    return result


def link01(contact):
    return frozenset((contact["geom1_body_name"], contact["geom2_body_name"])) == TARGET_PAIR


def expected_task_contact(contact):
    return "hole" in (contact["geom1_body_name"].lower(), contact["geom2_body_name"].lower())


def finite_json(value):
    json.dumps(value, allow_nan=False)


def main():
    OUT.mkdir(parents=True, exist_ok=False)
    reference = json.loads((OLD / "episode.json").read_text())
    actions = [json.loads(line) for line in (OLD / "transitions.jsonl").open()]
    current_bindings = bindings()
    telemetry_gate = json.loads((ROOT / "results/validation/peg/f3_axial_telemetry_20260905/binding.json").read_text())

    if exclusions(SOURCE) != [TARGET_PAIR] or exclusions(GENERATED) != [TARGET_PAIR]:
        raise RuntimeError("source/generated exclusion mismatch")
    for filename, digest in telemetry_gate["telemetry_files"].items():
        if sha(ROOT / filename) != digest:
            raise RuntimeError("telemetry binding mismatch: " + filename)
    if sha(telemetry_gate["installed_solver_file"]) != telemetry_gate["installed_solver_sha256"]:
        raise RuntimeError("installed IK solver binding mismatch")
    processes = subprocess.check_output(["ps", "-eo", "pid,args"], text=True)
    forbidden = ("scripts/record_peg_v2_demo.py", "scripts/run_peg_training.py")
    conflicts = [line for line in processes.splitlines() if any(token in line for token in forbidden)]
    if conflicts:
        raise RuntimeError("conflicting process: " + conflicts[0])

    for line in (ROOT / "configs/peg_insertion/runtime_gpu_formal.env").read_text().splitlines():
        if line.strip():
            key, value = line.split("=", 1)
            os.environ[key] = value
    sys.path[:0] = [str(PKG / "code/example/async_rlpd_peg_sim"), str(PKG / "code/env")]
    from mujoco import MjModel
    MjModel.from_xml_path(str(GENERATED))

    durable_save(OUT / "preflight.json", dict(
        status="PASS", observation_contract_version=V2, current_bindings=current_bindings,
        historical_action_source_sha256=sha(OLD / "transitions.jsonl"),
        source_exclusions=[sorted(pair) for pair in exclusions(SOURCE)],
        generated_exclusions=[sorted(pair) for pair in exclusions(GENERATED)],
        generated_xml_compile="PASS", telemetry_binding=telemetry_gate,
        max_diagnostic_steps=MAX_DIAGNOSTIC_STEPS, training_data_eligible=False,
        no_conflicting_processes=True, runner_sha256=sha(__file__),
        action_source="frozen failed-pilot action sequence; diagnostic replay only, not Demo recording"))

    from peg_env_adapter import make_peg_state_env
    from training.peg_insertion.peg_runtime_adapter import portable_peg_runtime

    env = None
    observer = None
    rows = []
    stop_reason = "NOT_STARTED"
    requested = 0.0
    realized = 0.0
    started = False
    initial_contacts = set()
    link01_reappeared = False
    try:
        started = True
        with portable_peg_runtime(ROOT):
            env = make_peg_state_env(render_mode="rgb_array", max_episode_steps=500)
        reset_result = env.reset(seed=0)
        initial = snapshot(env)
        validate_snapshot(initial)
        if env.observation_contract_version != V2:
            raise RuntimeError("V2 observation contract required")
        if not np.array_equal(np.asarray(initial["obs"]), np.asarray(reference["initial"]["obs"])):
            raise RuntimeError("fixed-reset observation differs from frozen standard reference")
        durable_save(OUT / "initial.json", dict(snapshot=initial, reset_info=reset_result[1], training_data_eligible=False))
        observer = AxialTelemetry(env, OUT / "telemetry")
        initial_contacts = persist_initial_evidence_and_guard(observer, initial, OUT)

        cartesian_path = OUT / "cartesian.jsonl"
        with cartesian_path.open("x", encoding="utf-8") as stream:
            for historical in actions[:MAX_DIAGNOSTIC_STEPS]:
                action = np.asarray(historical["action"], dtype=np.float32)
                before = snapshot(env)
                returned = observer.step(action)  # the sole environment step dispatch
                after = snapshot(env)
                telemetry = observer.last
                step = int(historical["step"])
                phase = historical["phase"]
                axial_delta = float(action[0] * 0.002) if phase == "insertion" else 0.0
                realized_delta = float(after["actual_ee_pose"][0] - before["actual_ee_pose"][0]) if phase == "insertion" else 0.0
                requested += axial_delta
                realized += realized_delta
                post_contacts = enrich_contacts(telemetry.get("post", {}).get("contacts", []) if telemetry else [], env.env.model)
                link01_reappeared = link01_reappeared or any(link01(contact) for contact in post_contacts)
                row = dict(
                    step=step, phase=phase, action=action.tolist(), before=before, after=after,
                    reward=float(returned[1]), terminated=bool(returned[2]), truncated=bool(returned[3]),
                    requested_axial_delta=axial_delta, cumulative_requested_axial=requested,
                    realized_ee_axial_delta=realized_delta, cumulative_realized_axial=realized,
                    target_actual_error=float(np.linalg.norm(np.asarray(after["target_pose"][:3]) - np.asarray(after["actual_ee_pose"][:3]))),
                    contacts=post_contacts, training_data_eligible=False)
                if telemetry and telemetry.get("ik", {}).get("q_target") is not None:
                    row["joint_actual_progress"] = (np.asarray(telemetry["post"]["qpos"]) - np.asarray(telemetry["pre"]["qpos"])).tolist()
                    solver = telemetry.get("solver", {})
                    residual = solver.get("residual")
                    returned_solver = solver.get("returned")
                    if residual is not None and returned_solver is not None and np.array_equal(
                            np.asarray(returned_solver[0]).reshape(-1), np.asarray(telemetry["ik"]["q_target"]).reshape(-1)):
                        row["ik_implied_axial_progress"] = float(
                            telemetry["ik"]["input_position"][0] + np.asarray(residual).reshape(-1)[0] - before["actual_ee_pose"][0])
                    else:
                        row["ik_implied_axial_progress"] = None
                else:
                    row["joint_actual_progress"] = None
                    row["ik_implied_axial_progress"] = None
                finite_json(row)
                rows.append(row)
                stream.write(json.dumps(row, allow_nan=False) + "\n")
                stream.flush()
                os.fsync(stream.fileno())

                stop_reason = None
                if not telemetry or not telemetry.get("complete") or telemetry.get("observer_errors") or telemetry.get("step_exception"):
                    stop_reason = "TELEMETRY_INCOMPLETE"
                else:
                    solver = telemetry.get("solver", {})
                    if not solver.get("return_available") or any(solver.get(key) is None for key in ("status", "residual", "cost", "nfev")):
                        stop_reason = "SOLVER_DATA_UNAVAILABLE"
                    elif not solver.get("success"):
                        stop_reason = "IK_SOLVER_NON_SUCCESS_" + str(solver.get("status"))
                    elif any(actuator["clip_flag"] for actuator in telemetry["post"]["actuators"]):
                        stop_reason = "UNEXPECTED_CONTROL_CLAMP"
                    elif any(link01(contact) for contact in post_contacts):
                        stop_reason = "LINK01_CONTACT_REAPPEARED"
                    elif any(contact["distance"] < -0.005 for contact in post_contacts):
                        stop_reason = "DANGEROUS_CONTACT_PENETRATION"
                    elif any(not expected_task_contact(contact) for contact in post_contacts):
                        stop_reason = "UNEXPECTED_NON_TASK_CONTACT"
                validate_snapshot(after)
                if requested >= 0.010 and realized <= 0.001:
                    stop_reason = stop_reason or "AXIAL_NONRESPONSE_THRESHOLD"
                if returned[2] or returned[3]:
                    stop_reason = stop_reason or "ENV_TERMINAL"
                print(json.dumps(dict(step=step, phase=phase, solver=(telemetry or {}).get("solver", {}).get("status"),
                    requested=requested, realized=realized, tracking_error=row["target_actual_error"], stop=stop_reason)), flush=True)
                if stop_reason:
                    break
        if not stop_reason:
            stop_reason = "BOUNDED_ACTIONS_EXHAUSTED"
    except BaseException as exc:
        stop_reason = "EXCEPTION: " + repr(exc)
        print(stop_reason, flush=True)
    finally:
        if observer:
            observer.close()
        if env:
            env.close()
        durable_save(OUT / "execution.json", dict(
            stop_reason=stop_reason, steps=len(rows), simulator_diagnostic_started=started,
            training_data_eligible=False, demo_recording_started=False, training_started=False,
            checkpoint_resumed=False, cumulative_requested_axial=requested,
            cumulative_realized_axial=realized, link01_contact_reappeared=link01_reappeared,
            initial_contact_pairs=[list(pair) for pair in sorted(initial_contacts)],
            production_bindings_unchanged=(bindings() == current_bindings), retry_count=0))


if __name__ == "__main__":
    main()
