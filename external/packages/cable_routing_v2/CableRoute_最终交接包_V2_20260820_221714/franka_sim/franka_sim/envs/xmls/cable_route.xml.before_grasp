<mujoco model="CableRoute">

  <include file="panda.xml"/>

  <option timestep=".002"
          noslip_iterations="5"
          noslip_tolerance="0"/>

  <statistic center="0.3 0 0.4" extent=".8"/>

  <visual>
    <headlight diffuse=".4 .4 .4" ambient=".5 .5 .5"/>
    <global azimuth="160"
            elevation="-20"
            offheight="128"
            offwidth="128"/>
    <quality offsamples="8"/>
  </visual>

  <asset>
    <texture type="skybox"
             builtin="gradient"
             rgb1=".3 .5 .7"
             rgb2="0 0 0"
             width="32"
             height="512"/>

    <texture name="grid"
             type="2d"
             builtin="checker"
             width="512"
             height="512"
             rgb1=".1 .2 .3"
             rgb2=".2 .3 .4"/>

    <material name="grid"
              texture="grid"
              texrepeat="2 2"
              texuniform="true"
              reflectance="0"/>
  </asset>

  <worldbody>

    <!-- Existing front camera -->
    <camera name="front"
            pos="1.3 0 0.7"
            quat="0.5963678 0.3799282 0.3799282 0.5963678"
            fovy="45"/>

    <light pos="0 0 3"
           dir="0 0 -1"
           diffuse="1 1 1"
           specular=".3 .3 .3"/>

    <geom name="floor"
          size="3 3 0.01"
          type="plane"
          material="grid"/>


    <!-- ================================================= -->
    <!-- CLIP: first simple U-shaped fixture                -->
    <!-- ================================================= -->

    <body name="clip" pos="0.50 0.10 0.025">

      <!-- bottom -->
      <geom name="clip_bottom"
            type="box"
            pos="0 0 0"
            size="0.045 0.030 0.010"
            rgba="0.2 0.2 0.8 1"
            friction="1 0.1 0.01"/>

      <!-- left wall -->
      <geom name="clip_left"
            type="box"
            pos="0 0.025 0.025"
            size="0.045 0.005 0.025"
            rgba="0.2 0.2 0.8 1"
            friction="1 0.1 0.01"/>

      <!-- right wall -->
      <geom name="clip_right"
            type="box"
            pos="0 -0.025 0.025"
            size="0.045 0.005 0.025"
            rgba="0.2 0.2 0.8 1"
            friction="1 0.1 0.01"/>

      <!-- debug / success reference -->
      <site name="slot_center"
            pos="0 0 0.030"
            size="0.008"
            rgba="0 1 0 0.5"/>

    </body>


    <!-- ================================================= -->
    <!-- CABLE: free cable for the first compile test      -->
    <!-- ================================================= -->

    <composite prefix="cable"
               type="cable"
               count="16 1 1"
               curve="s"
               size="0.30 0 0"
               initial="free">

      <joint kind="main"
             damping="0.02"/>

      <geom type="capsule"
            size="0.006"
            rgba="0.9 0.15 0.1 1"
            friction="1.2 0.1 0.01"/>

    </composite>


    <!-- Existing Panda mocap control target.
         DO NOT remove this. -->
    <body name="target"
          pos=".15 0 .5"
          quat="0 1 0 0"
          mocap="true">

      <geom name="target"
            type="box"
            size=".03 .03 .03"
            contype="0"
            conaffinity="0"
            rgba=".6 .3 .3 0"/>

    </body>

  </worldbody>

</mujoco>
