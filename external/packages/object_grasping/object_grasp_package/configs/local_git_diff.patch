+def evaluate_with_success(policy_fn, env, num_episodes):
+    rewards = []
+    lengths = []
+    successes = []
+    max_lift_heights = []
+
+    for episode_idx in range(num_episodes):
+        reset_result = env.reset()
+
+        if isinstance(reset_result, tuple) and len(reset_result) == 2:
+            obs, _ = reset_result
+        else:
+            obs = reset_result
+
+        done = False
+        episode_reward = 0.0
+        episode_length = 0
+        episode_success = False
+        max_lift_height = float("-inf")
+
+        while not done:
+            try:
+                action = policy_fn(observations=obs)
+            except TypeError:
+                action = policy_fn(obs)
+
+            step_result = env.step(action)
+
+            if len(step_result) == 5:
+                obs, reward, terminated, truncated, info = step_result
+                done = bool(terminated or truncated)
+            elif len(step_result) == 4:
+                obs, reward, done, info = step_result
+                done = bool(done)
+            else:
+                raise RuntimeError(
+                    f"Unexpected env.step() return length: {len(step_result)}"
+                )
+
+            episode_reward += float(np.asarray(reward).mean())
+            episode_length += 1
+
+            if isinstance(info, dict):
+                if bool(info.get("success", False)):
+                    episode_success = True
+
+                if "lift_height" in info:
+                    try:
+                        max_lift_height = max(
+                            max_lift_height,
+                            float(info["lift_height"]),
+                        )
+                    except Exception:
+                        pass
+
+        rewards.append(episode_reward)
+        lengths.append(episode_length)
+        successes.append(float(episode_success))
+
+        if max_lift_height == float("-inf"):
+            max_lift_height = float("nan")
+
+        max_lift_heights.append(max_lift_height)
+
+        print(
+            f"[EVAL EPISODE] "
+            f"{episode_idx + 1}/{num_episodes} "
+            f"reward={episode_reward:.6f} "
+            f"length={episode_length} "
+            f"success={episode_success} "
+            f"max_lift_height={max_lift_height:.4f}",
+            flush=True,
+        )
+
+    success_count = int(np.sum(successes))
+    success_rate = float(np.mean(successes))
+
+    return {
+        "episode.r": float(np.mean(rewards)),
+        "episode.r_std": float(np.std(rewards)),
+        "episode.l": float(np.mean(lengths)),
+        "success_rate": success_rate,
+        "success_count": success_count,
+        "num_episodes": int(num_episodes),
+        "max_lift_height_mean": float(
+            np.nanmean(max_lift_heights)
+        ),
+        "max_lift_height_max": float(
+            np.nanmax(max_lift_heights)
+        ),
+    }
+
+
